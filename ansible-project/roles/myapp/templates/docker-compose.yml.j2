version: '3.8'

services:
  app:
    build:
      context: "{{ project_path }}"
      dockerfile: Dockerfile
    container_name: {{ app_name }}_go
    ports:
      - "{{ app_port }}:{{ app_port }}"
    environment:
      - bd=postgres://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
    networks:
      - app_network
    restart: unless-stopped

networks:
  app_network:
    driver: bridge