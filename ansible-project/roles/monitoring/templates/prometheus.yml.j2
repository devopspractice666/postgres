global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']

  - job_name: 'myapp'
    static_configs:
      - targets:
{% for host in groups['app_host'] %}
          - '{{ hostvars[host].ansible_host | default(host) }}:{{ app_port }}'
{% endfor %}

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - '{{ hostvars[host].ansible_host | default(host) }}:9100'
{% endfor %}

  - job_name: 'postgres_exporter'
    static_configs:
      - targets:
{% for host in groups['db_host'] %}
          - '{{ hostvars[host].ansible_host | default(host) }}:9187'
{% endfor %}